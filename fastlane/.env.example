# Copy this file to  fastlane/.env  and fill in the values.
# fastlane/.env is git-ignored — never commit real keys.
# fastlane loads fastlane/.env automatically on every run.

# ── iOS: App Store Connect API key ───────────────────────────────────────────
# App Store Connect → Users and Access → Integrations → App Store Connect API
# Create a key with the "App Manager" role, download the .p8 ONCE, and drop it
# in fastlane/ (the *.p8 is git-ignored).
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=./fastlane/AuthKey_XXXXXXXXXX.p8

# ── Android: Google Play service-account JSON ────────────────────────────────
# Play Console → Setup → API access → create/link a service account, grant it
# "Release to testing/production" + "Release apps to testing tracks", download
# the JSON, drop it in fastlane/ (git-ignored).
PLAY_JSON_KEY_PATH=./fastlane/play-service-account.json
